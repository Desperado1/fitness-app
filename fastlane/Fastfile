default_platform(:ios)

APP_IDENTIFIER = "com.flowwfit.app".freeze

# App Store Connect API key auth — no Apple ID password, no 2FA prompts.
# ASC_KEY_CONTENT is the base64 of the .p8 file you downloaded from
# App Store Connect (see docs/TESTFLIGHT.md).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

platform :ios do
  desc "Build a signed Release IPA and upload it to TestFlight"
  lane :beta do
    # Creates a throwaway keychain on the CI runner so signing works headless.
    setup_ci

    api_key = asc_api_key

    # Fetch (or, on the very first run, create) the shared distribution
    # certificate + App Store provisioning profile from the match store.
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      api_key: api_key,
      readonly: false
    )

    # TestFlight rejects duplicate build numbers for the same version, so use
    # the monotonic GitHub Actions run number (falls back to a timestamp locally).
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    build_app(
      project: "FlowFit.xcodeproj",
      scheme: "FlowFit",
      configuration: "Release",
      export_method: "app-store",
      output_name: "FlowFit.ipa",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
